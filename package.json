{
  "name": "otakusoul",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:linux": "GDK_BACKEND=x11 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "check": "npm run check:rust && npm run check:web",
    "types:gen": "cargo test --manifest-path src-tauri/Cargo.toml --lib export_bindings",
    "lint": "oxlint",
    "check:web": "oxlint && tsc --noEmit && vitest run",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "@pixiv/three-vrm": "^3.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "lucide-react": "^1.48.0",
    "pixi.js": "^8.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "untitled-pixi-live2d-engine": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  }
}
