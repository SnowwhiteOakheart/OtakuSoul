# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node
node_modules/
dist/
dist-ssr/
*.local

# Rust & Tauri
/target/
src-tauri/target/
src-tauri/gen/schemas/

# Environment & Secrets
.env
.env.*
!.env.example

# Large AI models & local binaries
bin/
models/
assets/models/
# Local test avatars (third-party models, never committed)
assets/test-avatars/
*.gguf
*.bin
*.pt
*.safetensors
*.onnx

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VRM-Modelle kommen als separates Avatar-Paket (tools/package_avatar_pack.sh);
# nur die beiden mitgelieferten Standardmodelle sind versioniert.
assets/vrm/*.vrm
!assets/vrm/Anime Girl.vrm
!assets/vrm/Anime Man.vrm

# Updater-Signaturschlüssel: niemals committen (privater Schlüssel + Passwort)
/.tauri-signing/

# ts-rs output when the root cargo config is not picked up; real bindings live in src/types/generated
/src-tauri/bindings/

output/
# End-to-end test screenshots
e2e/screenshots/

# Leftovers of failed patches
*.orig
*.rej
